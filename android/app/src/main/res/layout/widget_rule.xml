<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/rw_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="14dp" android:background="@drawable/widget_bg">
  <TextView android:id="@+id/rw_title" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:textColor="#E2C27A" android:textSize="15sp" android:textStyle="bold" android:fontFamily="serif" android:paddingBottom="4dp"/>
  <TextView android:id="@+id/rw_0" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"
      android:textColor="#FFFFFF" android:textSize="15sp" android:paddingTop="7dp" android:paddingBottom="7dp" android:maxLines="1" android:ellipsize="end"/>
  <TextView android:id="@+id/rw_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"
      android:textColor="#FFFFFF" android:textSize="15sp" android:paddingTop="7dp" android:paddingBottom="7dp" android:maxLines="1" android:ellipsize="end"/>
  <TextView android:id="@+id/rw_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"
      android:textColor="#FFFFFF" android:textSize="15sp" android:paddingTop="7dp" android:paddingBottom="7dp" android:maxLines="1" android:ellipsize="end"/>
  <TextView android:id="@+id/rw_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"
      android:textColor="#FFFFFF" android:textSize="15sp" android:paddingTop="7dp" android:paddingBottom="7dp" android:maxLines="1" android:ellipsize="end"/>
  <TextView android:id="@+id/rw_4" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"
      android:textColor="#FFFFFF" android:textSize="15sp" android:paddingTop="7dp" android:paddingBottom="7dp" android:maxLines="1" android:ellipsize="end"/>
  <TextView android:id="@+id/rw_5" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"
      android:textColor="#FFFFFF" android:textSize="15sp" android:paddingTop="7dp" android:paddingBottom="7dp" android:maxLines="1" android:ellipsize="end"/>
  <TextView android:id="@+id/rw_foot" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:textColor="#E2C27A" android:textSize="12sp" android:layout_marginTop="4dp"/>
</LinearLayout>
