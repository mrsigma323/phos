# Phos: compresión y caché para que la web cargue rápido en Hostinger
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/manifest+json
</IfModule>
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/json "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<FilesMatch "sw\.js$">
  Header set Cache-Control "no-cache"
</FilesMatch>

ErrorDocument 404 /404.html

# Páginas con datos del titular o de cuenta: que los buscadores no las indexen
<FilesMatch "^(aviso-legal|privacidad|cookies|mi-phos)\.html$">
  Header set X-Robots-Tag "noindex, noarchive, nosnippet"
</FilesMatch>
