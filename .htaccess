# Phos: compresión y caché para que la web cargue rápido en Hostinger
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/manifest+json
</IfModule>
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/json "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<FilesMatch "sw\.js$">
  Header set Cache-Control "no-cache"
</FilesMatch>

ErrorDocument 404 /404.html

# Páginas con datos del titular o de cuenta: que los buscadores no las indexen
<FilesMatch "^(aviso-legal|privacidad|cookies|mi-phos)\.html$">
  Header set X-Robots-Tag "noindex, noarchive, nosnippet"
</FilesMatch>

# Enlaces cortos a las redes sociales de Phos
Redirect 302 /facebook https://www.facebook.com/61596423448217

# Seguridad: siempre por HTTPS y cabeceras de protección del navegador
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=15552000" env=HTTPS
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
</IfModule>
